      <meta name="theme-color" content="#ffffff">
+ 
+ 
+     <style>
+ 
+         :root {
+             --background: #ffffff;
+             --surface: #f7f8fa;
+             --surface-dark: #111111;
+             --text: #171717;
+             --text-secondary: #666666;
+             --border: #e6e6e6;
+             --accent: #2457d6;
+             --accent-light: #eef3ff;
+             --max-width: 1120px;
+         }
+ 
+ 
+         * {
+             box-sizing: border-box;
+         }
+ 
+ 
+         html {
+             scroll-behavior: smooth;
+         }
+ 
+ 
+         body {
+             margin: 0;
+             font-family: -apple-system,
+                 BlinkMacSystemFont,
+                 "Segoe UI",
+                 Roboto,
+                 Helvetica,
+                 Arial,
+                 sans-serif;
+ 
+             color: var(--text);
+             background: var(--background);
+             line-height: 1.6;
+         }
+ 
+ 
+         a {
+             color: inherit;
+             text-decoration: none;
+         }
+ 
+ 
+         .container {
+             width: min(100% - 40px, var(--max-width));
+             margin: 0 auto;
+         }
+ 
+ 
+         /* =========================
+            NAVIGATION
+         ========================= */
+ 
+         .navbar {
+             position: sticky;
+             top: 0;
+             z-index: 1000;
+ 
+             background: rgba(255, 255, 255, 0.94);
+             backdrop-filter: blur(10px);
+ 
+             border-bottom: 1px solid var(--border);
+         }
+ 
+ 
+         .navbar-inner {
+             min-height: 68px;
+ 
+             display: flex;
+             align-items: center;
+             justify-content: space-between;
+         }
+ 
+ 
+         .brand {
+             display: flex;
+             align-items: center;
+             gap: 12px;
+ 
+             font-weight: 600;
+         }
+ 
+ 
+         .brand img {
+             width: 42px;
+             height: 42px;
+ 
+             border-radius: 50%;
+             object-fit: cover;
+         }
+ 
+ 
+         .brand-name {
+             font-size: 16px;
+         }
+ 
+ 
+         .nav-links {
+             display: flex;
+             align-items: center;
+             gap: 28px;
+         }
+ 
+ 
+         .nav-links a {
+             color: #555;
+             font-size: 14px;
+ 
+             transition: color 0.2s ease;
+         }
+ 
+ 
+         .nav-links a:hover {
+             color: var(--text);
+         }
+ 
+ 
+         .linkedin-link {
+             font-size: 21px !important;
+         }
+ 
+ 
+         /* =========================
+            HERO
+         ========================= */
+ 
+         .hero {
+             padding: 110px 0 120px;
+         }
+ 
+ 
+         .hero-content {
+             max-width: 900px;
+         }
+ 
+ 
+         .hero-eyebrow {
+             display: inline-flex;
+             align-items: center;
+             gap: 8px;
+ 
+             margin-bottom: 22px;
+             padding: 7px 13px;
+ 
+             background: var(--accent-light);
+             color: var(--accent);
+ 
+             border-radius: 20px;
+ 
+             font-size: 13px;
+             font-weight: 600;
+         }
+ 
+ 
+         .hero h1 {
+             margin: 0 0 25px;
+ 
+             font-size: clamp(46px, 7vw, 78px);
+             line-height: 1.02;
+ 
+             letter-spacing: -0.045em;
+             font-weight: 700;
+         }
+ 
+ 
+         .hero-title {
+             font-size: clamp(22px, 3vw, 30px);
+             line-height: 1.3;
+ 
+             font-weight: 500;
+ 
+             color: #444;
+ 
+             max-width: 850px;
+ 
+             margin-bottom: 28px;
+         }
+ 
+ 
+         .hero-description {
+             max-width: 760px;
+ 
+             font-size: 18px;
+ 
+             color: var(--text-secondary);
+ 
+             margin: 0;
+         }
+ 
+ 
+         .hero-actions {
+             display: flex;
+             gap: 14px;
+ 
+             margin-top: 35px;
+ 
+             flex-wrap: wrap;
+         }
+ 
+ 
+         .button {
+             display: inline-flex;
+             align-items: center;
+             justify-content: center;
+             gap: 9px;
+ 
+             padding: 12px 20px;
+ 
+             border-radius: 7px;
+ 
+             font-size: 14px;
+             font-weight: 600;
+ 
+             transition: all 0.2s ease;
+         }
+ 
+ 
+         .button-primary {
+             color: white;
+             background: var(--surface-dark);
+         }
+ 
+ 
+         .button-primary:hover {
+             transform: translateY(-1px);
+             opacity: 0.9;
+         }
+ 
+ 
+         .button-secondary {
+             border: 1px solid var(--border);
+ 
+             color: var(--text);
+             background: white;
+         }
+ 
+ 
+         .button-secondary:hover {
+             background: var(--surface);
+         }
+ 
+ 
+         /* =========================
+            SECTIONS
+         ========================= */
+ 
+         section {
+             padding: 100px 0;
+         }
+ 
+ 
+         .section-label {
+             color: var(--accent);
+ 
+             text-transform: uppercase;
+ 
+             letter-spacing: 0.12em;
+ 
+             font-size: 12px;
+             font-weight: 700;
+ 
+             margin-bottom: 12px;
+         }
+ 
+ 
+         .section-title {
+             margin: 0 0 45px;
+ 
+             font-size: clamp(32px, 5vw, 46px);
+ 
+             line-height: 1.1;
+ 
+             letter-spacing: -0.035em;
+         }
+ 
+ 
+         /* =========================
+            ABOUT
+         ========================= */
+ 
+         .about {
+             background: var(--surface);
+         }
+ 
+ 
+         .about-grid {
+             display: grid;
+ 
+             grid-template-columns: 0.8fr 1.2fr;
+ 
+             gap: 80px;
+ 
+             align-items: start;
+         }
+ 
+ 
+         .about-intro {
+             font-size: 22px;
+ 
+             line-height: 1.45;
+ 
+             font-weight: 500;
+         }
+ 
+ 
+         .about-text {
+             color: var(--text-secondary);
+ 
+             font-size: 17px;
+         }
+ 
+ 
+         .about-text p {
+             margin-top: 0;
+             margin-bottom: 22px;
+         }
+ 
+ 
+         /* =========================
+            EXPERTISE
+         ========================= */
+ 
+         .expertise-grid {
+             display: grid;
+ 
+             grid-template-columns: repeat(4, 1fr);
+ 
+             gap: 1px;
+ 
+             background: var(--border);
+ 
+             border: 1px solid var(--border);
+         }
+ 
+ 
+         .expertise-card {
+             background: white;
+ 
+             padding: 32px 26px;
+ 
+             min-height: 180px;
+         }
+ 
+ 
+         .expertise-icon {
+             font-size: 22px;
+ 
+             color: var(--accent);
+ 
+             margin-bottom: 25px;
+         }
+ 
+ 
+         .expertise-card h3 {
+             margin: 0 0 10px;
+ 
+             font-size: 18px;
+         }
+ 
+ 
+         .expertise-card p {
+             margin: 0;
+ 
+             color: var(--text-secondary);
+ 
+             font-size: 14px;
+         }
+ 
+ 
+         /* =========================
+            CURRENT EXPERIENCE
+         ========================= */
+ 
+         .experience {
+             background: var(--surface);
+         }
+ 
+ 
+         .experience-intro {
+             max-width: 760px;
+ 
+             color: var(--text-secondary);
+ 
+             font-size: 17px;
+ 
+             margin-bottom: 50px;
+         }
+ 
+ 
+         .experience-grid {
+             display: grid;
+ 
+             grid-template-columns: repeat(2, 1fr);
+ 
+             gap: 25px;
+         }
+ 
+ 
+         .experience-card {
+             background: white;
+ 
+             border: 1px solid var(--border);
+ 
+             border-radius: 10px;
+ 
+             padding: 35px;
+ 
+             transition:
+                 transform 0.2s ease,
+                 box-shadow 0.2s ease;
+         }
+ 
+ 
+         .experience-card:hover {
+             transform: translateY(-3px);
+ 
+             box-shadow:
+                 0 12px 35px rgba(0, 0, 0, 0.07);
+         }
+ 
+ 
+         .experience-icon {
+             width: 46px;
+             height: 46px;
+ 
+             display: flex;
+             align-items: center;
+             justify-content: center;
+ 
+             margin-bottom: 25px;
+ 
+             border-radius: 8px;
+ 
+             background: var(--accent-light);
+ 
+             color: var(--accent);
+ 
+             font-size: 19px;
+         }
+ 
+ 
+         .experience-card h3 {
+             margin: 0 0 15px;
+ 
+             font-size: 22px;
+ 
+             line-height: 1.3;
+         }
+ 
+ 
+         .experience-card > p {
+             color: var(--text-secondary);
+ 
+             margin-bottom: 25px;
+         }
+ 
+ 
+         .experience-card ul {
+             padding-left: 20px;
+ 
+             margin: 0;
+ 
+             color: #555;
+ 
+             font-size: 14px;
+         }
+ 
+ 
+         .experience-card li {
+             margin-bottom: 10px;
+         }
+ 
+ 
+         /* =========================
+            HOW I WORK
+         ========================= */
+ 
+         .how-i-work {
+             background: white;
+         }
+ 
+ 
+         .how-intro {
+             max-width: 760px;
+ 
+             color: var(--text-secondary);
+ 
+             font-size: 18px;
+ 
+             margin-bottom: 45px;
+         }
+ 
+ 
+         .automation-card {
+             display: grid;
+ 
+             grid-template-columns: auto 1fr;
+ 
+             gap: 25px;
+ 
+             padding: 40px;
+ 
+             background: var(--surface-dark);
+ 
+             color: white;
+ 
+             border-radius: 10px;
+         }
+ 
+ 
+         .automation-icon {
+             width: 54px;
+             height: 54px;
+ 
+             display: flex;
+             align-items: center;
+             justify-content: center;
+ 
+             border-radius: 10px;
+ 
+             background: #242424;
+ 
+             color: #9db7ff;
+ 
+             font-size: 22px;
+         }
+ 
+ 
+         .automation-card h3 {
+             margin: 0 0 12px;
+ 
+             font-size: 25px;
+         }
+ 
+ 
+         .automation-card p {
+             margin: 0;
+ 
+             max-width: 750px;
+ 
+             color: #bdbdbd;
+ 
+             font-size: 16px;
+         }
+ 
+ 
+         /* =========================
+            CONTACT
+         ========================= */
+ 
+         .contact {
+             background: var(--surface-dark);
+ 
+             color: white;
+ 
+             text-align: center;
+         }
+ 
+ 
+         .contact .section-label {
+             color: #9db7ff;
+         }
+ 
+ 
+         .contact h2 {
+             margin-bottom: 20px;
+         }
+ 
+ 
+         .contact-text {
+             max-width: 620px;
+ 
+             margin: 0 auto 35px;
+ 
+             color: #aaa;
+ 
+             font-size: 17px;
+         }
+ 
+ 
+         .contact-links {
+             display: flex;
+ 
+             justify-content: center;
+ 
+             gap: 18px;
+ 
+             flex-wrap: wrap;
+         }
+ 
+ 
+         .contact-link {
+             display: inline-flex;
+ 
+             align-items: center;
+ 
+             gap: 10px;
+ 
+             padding: 12px 18px;
+ 
+             border: 1px solid #333;
+ 
+             border-radius: 7px;
+ 
+             color: white;
+ 
+             transition: background 0.2s ease;
+         }
+ 
+ 
+         .contact-link:hover {
+             background: #222;
+         }
+ 
+ 
+         /* =========================
+            FOOTER
+         ========================= */
+ 
+         footer {
+             padding: 25px 0;
+ 
+             background: var(--surface-dark);
+ 
+             color: #666;
+ 
+             border-top: 1px solid #222;
+ 
+             text-align: center;
+ 
+             font-size: 12px;
+         }
+ 
+ 
+         /* =========================
+            RESPONSIVE
+         ========================= */
+ 
+         @media (max-width: 900px) {
+ 
+             .about-grid {
+                 grid-template-columns: 1fr;
+ 
+                 gap: 35px;
+             }
+ 
+ 
+             .expertise-grid {
+                 grid-template-columns: repeat(2, 1fr);
+             }
+ 
+ 
+             .experience-grid {
+                 grid-template-columns: 1fr;
+             }
+ 
+         }
+ 
+ 
+         @media (max-width: 700px) {
+ 
+             .container {
+                 width: min(100% - 28px, var(--max-width));
+             }
+ 
+ 
+             .navbar-inner {
+                 min-height: 60px;
+             }
+ 
+ 
+             .brand-name {
+                 display: none;
+             }
+ 
+ 
+             .nav-links {
+                 gap: 15px;
+             }
+ 
+ 
+             .nav-links a {
+                 font-size: 12px;
+             }
+ 
+ 
+             .hero {
+                 padding: 75px 0 85px;
+             }
+ 
+ 
+             section {
+                 padding: 75px 0;
+             }
+ 
+ 
+             .hero-title {
+                 font-size: 21px;
+             }
+ 
+ 
+             .hero-description {
+                 font-size: 16px;
+             }
+ 
+ 
+             .expertise-grid {
+                 grid-template-columns: 1fr;
+             }
+ 
+ 
+             .automation-card {
+                 grid-template-columns: 1fr;
+ 
+                 padding: 30px;
+             }
+ 
+         }
+ 
+     </style>
+ 
  </head>
  
